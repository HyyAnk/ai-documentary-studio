# Server-side ShopAIKey image generation settings
SHOPAIKEY_API_KEY=your_shopaikey_api_key_here
SHOPAIKEY_BASE_URL=https://direct.shopaikey.com/v1
SHOPAIKEY_IMAGE_MODEL=gpt-image-2
# Models are tried in sequence if the previous model is unavailable or rejects a request.
SHOPAIKEY_IMAGE_FALLBACK_MODELS=gpt-image-1.5,gpt-image-1,gpt-image-2-all
# Pilot-safe defaults; change only after reviewing the sample output.
SHOPAIKEY_IMAGE_SIZE=1536x1024
SHOPAIKEY_IMAGE_QUALITY=low

# HyperFrames video render settings
PRODUCER_PAGE_NAVIGATION_TIMEOUT_MS=300000
HYPERFRAMES_BROWSER_TIMEOUT_SECONDS=300
# HYPERFRAMES_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
