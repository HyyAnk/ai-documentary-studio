# Server-side ShopAIKey image generation settings
SHOPAIKEY_API_KEY=your_shopaikey_api_key_here
SHOPAIKEY_BASE_URL=https://direct.shopaikey.com/v1
SHOPAIKEY_IMAGE_MODEL=gpt-image-2
# Pilot-safe defaults; change only after reviewing the sample output.
SHOPAIKEY_IMAGE_SIZE=1536x1024
SHOPAIKEY_IMAGE_QUALITY=low
